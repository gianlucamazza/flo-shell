#%PAM-1.0
# PAM service of the flo-shell lock screen. Quickshell opens it from
# /etc/pam.d directly (PamContext configDirectory), so it cannot include
# stacks that live elsewhere (Alpine keeps base-auth in /usr/lib/pam.d):
# the rules are spelled out.
auth     required pam_unix.so
auth     optional pam_gnome_keyring.so
account  required pam_unix.so
